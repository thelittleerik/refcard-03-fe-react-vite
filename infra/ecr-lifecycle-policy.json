{
  "rules": [
    {
      "rulePriority": 1,
      "description": "Untagged Images nach 3 Tagen entfernen",
      "selection": {
        "tagStatus": "untagged",
        "countType": "sinceImagePushed",
        "countUnit": "days",
        "countNumber": 3
      },
      "action": { "type": "expire" }
    },
    {
      "rulePriority": 2,
      "description": "Nur die letzten 15 Commit-Images (sha-...) behalten, Release-Tags bleiben erhalten",
      "selection": {
        "tagStatus": "tagged",
        "tagPrefixList": ["sha-"],
        "countType": "imageCountMoreThan",
        "countNumber": 15
      },
      "action": { "type": "expire" }
    }
  ]
}
